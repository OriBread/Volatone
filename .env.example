# Copy to .env and adjust. .env is git-ignored; this file is the documented template.

# --- Database (used by docker-compose and the backend) ---
POSTGRES_USER=volatone
POSTGRES_PASSWORD=volatone
POSTGRES_DB=volatone

# --- Backend (prefix VOLATONE_ is read by backend/src/volatone/config.py) ---
VOLATONE_ENVIRONMENT=development
VOLATONE_DATABASE_URL=postgresql://volatone:volatone@localhost:5432/volatone
VOLATONE_CORS_ORIGINS=["http://localhost:5173"]

